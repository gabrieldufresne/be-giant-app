{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/editorial/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Serrif Condensed|Gibson Book|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Serrif Condensed, Gibson Book, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleCardArticle'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|href|dek|image|imageAlt|topic|topicColor|authors|publishedAt|key|ref|className|style|children)$/]",
        "message": "<ArticleCardArticle> doesn't accept that prop. Declared props: title, href, dek, image, imageAlt, topic, topicColor, authors, publishedAt."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleCardSmall'] > JSXAttribute > JSXIdentifier[name!=/^(?:article|thumbSize|style|key|ref|className|style|children)$/]",
        "message": "<ArticleCardSmall> doesn't accept that prop. Declared props: article, thumbSize, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AuthorBylineAuthor'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|href|key|ref|className|style|children)$/]",
        "message": "<AuthorBylineAuthor> doesn't accept that prop. Declared props: name, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|secondary|destructive|outline)$/]",
        "message": "<Badge> variant must be one of 'default' | 'secondary' | 'destructive' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Breadcrumb'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|style|key|ref|className|style|children)$/]",
        "message": "<Breadcrumb> doesn't accept that prop. Declared props: items, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|secondary|outline|ghost|destructive|link)$/]",
        "message": "<Button> variant must be one of 'default' | 'secondary' | 'outline' | 'ghost' | 'destructive' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|sm|lg|icon)$/]",
        "message": "<Button> size must be one of 'default' | 'sm' | 'lg' | 'icon'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonUtilityOutline'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|target|showIcon|onClick|disabled|style|key|ref|className|style|children)$/]",
        "message": "<ButtonUtilityOutline> doesn't accept that prop. Declared props: children, href, target, showIcon, onClick, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonUtilityOutline'] > JSXAttribute[name.name='target'] > Literal[value!=/^(?:_blank|_self|_parent|_top)$/]",
        "message": "<ButtonUtilityOutline> target must be one of '_blank' | '_self' | '_parent' | '_top'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DateDisplay'] > JSXAttribute > JSXIdentifier[name!=/^(?:dateString|style|key|ref|className|style|children)$/]",
        "message": "<DateDisplay> doesn't accept that prop. Declared props: dateString, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EditorialNotice'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|date|children|style|key|ref|className|style|children)$/]",
        "message": "<EditorialNotice> doesn't accept that prop. Declared props: kind, date, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EditorialNotice'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:correction|clarification|note)$/]",
        "message": "<EditorialNotice> kind must be one of 'correction' | 'clarification' | 'note'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|as|light|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, as, light, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:span|p|h2|h3)$/]",
        "message": "<Eyebrow> as must be one of 'span' | 'p' | 'h2' | 'h3'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FigureCaption'] > JSXAttribute > JSXIdentifier[name!=/^(?:caption|credit|light|align|style|key|ref|className|style|children)$/]",
        "message": "<FigureCaption> doesn't accept that prop. Declared props: caption, credit, light, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FigureCaption'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<FigureCaption> align must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:groups|social|blurb|address|legal|logoSrc|textureSrc|style|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: groups, social, blurb, address, legal, logoSrc, textureSrc, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeaderNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:primaryNav|pillars|series|topics|pages|logoSrc|iconBase|compact|menuOpen|onToggleMenu|onSearch|style|key|ref|className|style|children)$/]",
        "message": "<HeaderNav> doesn't accept that prop. Declared props: primaryNav, pillars, series, topics, pages, logoSrc, iconBase, compact, menuOpen, onToggleMenu, onSearch, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|alt|invert|basePath|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, alt, invert, basePath, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LinkMore'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|arrow|style|key|ref|className|style|children)$/]",
        "message": "<LinkMore> doesn't accept that prop. Declared props: label, href, arrow, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LinkMore'] > JSXAttribute[name.name='arrow'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<LinkMore> arrow must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NewsletterForm'] > JSXAttribute > JSXIdentifier[name!=/^(?:heading|body|variant|illustrationSrc|state|style|key|ref|className|style|children)$/]",
        "message": "<NewsletterForm> doesn't accept that prop. Declared props: heading, body, variant, illustrationSrc, state, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NewsletterForm'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:panel|inline)$/]",
        "message": "<NewsletterForm> variant must be one of 'panel' | 'inline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NewsletterForm'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|loading|success)$/]",
        "message": "<NewsletterForm> state must be one of 'idle' | 'loading' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillarFilterBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:pillars|activePillar|onPillarChange|filters|totalCount|sort|viewMode|onViewModeChange|iconBase|style|key|ref|className|style|children)$/]",
        "message": "<PillarFilterBar> doesn't accept that prop. Declared props: pillars, activePillar, onPillarChange, filters, totalCount, sort, viewMode, onViewModeChange, iconBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillarFilterBar'] > JSXAttribute[name.name='viewMode'] > Literal[value!=/^(?:grid|list)$/]",
        "message": "<PillarFilterBar> viewMode must be one of 'grid' | 'list'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RailCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:article|showThumbnail|style|key|ref|className|style|children)$/]",
        "message": "<RailCard> doesn't accept that prop. Declared props: article, showThumbnail, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|as|moreLabel|moreHref|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: children, as, moreLabel, moreHref, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:h1|h2|h3)$/]",
        "message": "<SectionHeading> as must be one of 'h1' | 'h2' | 'h3'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Separator'] > JSXAttribute > JSXIdentifier[name!=/^(?:orientation|strong|style|key|ref|className|style|children)$/]",
        "message": "<Separator> doesn't accept that prop. Declared props: orientation, strong, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Separator'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:horizontal|vertical)$/]",
        "message": "<Separator> orientation must be one of 'horizontal' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShareTools'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|iconBase|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ShareTools> doesn't accept that prop. Declared props: label, iconBase, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Skeleton'] > JSXAttribute > JSXIdentifier[name!=/^(?:style|key|ref|className|style|children)$/]",
        "message": "<Skeleton> doesn't accept that prop. Declared props: style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopicBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|color|isFranchise|light|href|style|key|ref|className|style|children)$/]",
        "message": "<TopicBadge> doesn't accept that prop. Declared props: title, color, isFranchise, light, href, style."
      }
    ]
  },
